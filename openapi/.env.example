# openapi 客户端配置示例：复制本文件为同目录下的 .env 后按实际环境填写
#
# 安全提示：
#   1. .env 已在 .gitignore 中忽略，请勿把真实密钥提交到仓库；
#   2. 导入 api/dbdata.sql 后，库里的 dt_app_list.secret 是占位值 CHANGE_ME，
#      请在后台「API管理」里改成一个随机密钥，并把同样的值填到下面的 OPENAPI_SECRET；
#   3. 生产环境请使用 https 地址。

OPENAPI_BASE_URL=http://admin.test.com
OPENAPI_APPID=admin
OPENAPI_SECRET=CHANGE_ME
