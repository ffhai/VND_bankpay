APP_DEBUG = false

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = dbdata
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false

[CORS]
# 允许跨域的来源，多个用英文逗号分隔，例如 https://admin.example.com
# 留空表示回显请求的 Origin（仅建议本地开发使用）
ALLOW_ORIGINS =

[LANG]
default_lang = zh-cn

[JWT]
# 生产环境务必配置为固定的 32 位以上随机串；留空时会自动生成并持久化到 runtime/jwt_key
SECRET = change-me-to-a-32-char-random-string